# Supabase
# Server-side URL for Dokploy and other runtime deployments.
SUPABASE_URL=https://your-project.supabase.co
# Legacy public URL fallback for local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only key (recommended). Used for all database access.
SUPABASE_SECRET_KEY=
# Optional server-side publishable key fallback.
SUPABASE_PUBLISHABLE_KEY=
# Fallback used if SUPABASE_SECRET_KEY is not set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clerk
# Server-side publishable key for runtime deployments such as Dokploy.
CLERK_PUBLISHABLE_KEY=
# Legacy public variable fallback for local development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Signs the cookie that remembers an unlocked password-protected paste.
# Falls back to CLERK_SECRET_KEY when unset. Any long random string works.
PASTE_UNLOCK_SECRET=

# Optional
NEXT_PUBLIC_SITE_URL=https://codebin.site
NEXT_PUBLIC_GA_ID=G-X67E6EX0FP
